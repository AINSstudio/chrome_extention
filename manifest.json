{
  "manifest_version": 3,
  "name": "AINS Studio",
  "version": "5.0.0",
  "description": "AINS Studio 5 with a full settings center, feature controls, reading tools, and Excel import.",
  "action": {
    "default_title": "Open AINS Studio settings"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://ains.moe.gov.my/web/*"],
  "content_scripts": [
    {
      "matches": ["https://ains.moe.gov.my/web/*"],
      "js": ["theme.js", "bulk-import.js", "studio-dashboard.js"],
      "run_at": "document_start"
    }
  ]
}













