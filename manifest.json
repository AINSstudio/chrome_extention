{
  "manifest_version": 3,
  "name": "AINS Studio",
  "version": "4.36.0",
  "description": "AINS dashboard with themes, reading statistics, and a password-gated Excel record importer.",
  "action": {
    "default_title": "AINS Studio",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://ains.moe.gov.my/web/*"],
      "css": ["styles.css"],
      "js": ["theme.js", "bulk-import.js", "studio-dashboard.js"],
      "run_at": "document_start"
    }
  ]
}













